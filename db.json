    {
      "id": "70c287ed-e9ca-46c7-97d9-d0da91525403",
      "subjectId": "99ffe7b5-4181-4eae-8de0-2ba543ca0e17",
      "topicIds": ["892a0746-90a6-43ba-80b2-234a113c96cd"],
      "type": "FLASHCARD",
      "text": "What is a linear equation?",
      "description": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Define a linear equation and give a simple example."
              }
            ]
          }
        ]
      },
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "A linear equation has variables only to the first power, such as 2x + 3 = 7."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-10-22T09:15:00.000Z",
      "updatedAt": "2026-10-22T09:15:00.000Z"
    },
    {
      "id": "45fe4230-d028-41e1-9104-e7ed9784ff5e",
      "subjectId": "99ffe7b5-4181-4eae-8de0-2ba543ca0e17",
      "topicIds": ["892a0746-90a6-43ba-80b2-234a113c96cd", "5UBrfpO8v6I"],
      "type": "FLASHCARD",
      "text": "What is the expected value of a random variable?",
      "description": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Explain the formula for a discrete random variable."
              }
            ]
          }
        ]
      },
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Expected value is the sum of each possible value multiplied by its probability: E[X] = sum(x * P(X = x))."
              }
            ]
          }
        ]
      },
      "createdAt": "2026-10-22T09:15:00.000Z",
      "updatedAt": "2026-10-22T09:15:00.000Z"
    },
    {
      "id": "yFyAGwRhQBo",
      "subjectId": "99ffe7b5-4181-4eae-8de0-2ba543ca0e17",
      "topicIds": ["892a0746-90a6-43ba-80b2-234a113c96cd", "5UBrfpO8v6I"],
      "type": "FLASHCARD",
      "text": "What is encapsulation in Java?",
      "description": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Explain how private fields and public methods work.ddsd"
              }
            ]
          }
        ]
      },
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Encapsulation is the practice of bundling data and methods tsdsdsogether while restricting direct access to internal data."
              }
            ]
          }
        ]
      },
      "createdAt": "Mon Oct 26 2026 10:08:17 GMT+0100 (Central European Standard Time)",
      "updatedAt": "2026-10-26T09:30:35.963Z"
    },
    {
      "id": "UwikDuxbzh8",
      "subjectId": "iLkDdmLMxr8",
      "topicIds": ["UJ-LNLJBqUw", "SE5FKAEP7Wk"],
      "type": "FLASHCARD",
      "text": "Question Test",
      "description": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Explain the differences between ArrayList and LinkedList in Java."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Consider the following:"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "How elements are stored."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Which is better for accessing elements by index."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "The performance of adding and removing elements."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Example code:"
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": {
              "language": null
            },
            "content": [
              {
                "type": "text",
                "text": "List<String> names = new ArrayList<>();\nnames.add(\"Java\");\nnames.add(\"React\");"
              }
            ]
          },
          {
            "type": "paragraph"
          },
          {
            "type": "image",
            "attrs": {
              "src": "https://code.visualstudio.com/docs/java/java-tutorial",
              "alt": "Study image",
              "title": null,
              "width": null,
              "height": null
            }
          },
          {
            "type": "paragraph"
          }
        ]
      },
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "ArrayList vs LinkedList"
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "ArrayList uses a resizable array internally, while LinkedList uses a doubly linked list."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Main differences:"
              }
            ]
          },
          {
            "type": "orderedList",
            "attrs": {
              "start": 1,
              "type": null
            },
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Access: ArrayList provides fast indexed access, while LinkedList requires traversal."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Insertion: LinkedList can insert or remove elements efficiently when the position is already known, but finding that position takes time."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Memory: LinkedList generally uses more memory because it stores node references."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Example:"
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": {
              "language": null
            },
            "content": [
              {
                "type": "text",
                "text": "List<Integer> numbers = new ArrayList<>();\nnumbers.add(10);\nnumbers.add(20);\n\nSystem.out.println(numbers.get(0)); // 10"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Conclusion"
              },
              {
                "type": "text",
                "text": ": ArrayList is usually the better default choice unless your use case specifically benefits from LinkedList."
              }
            ]
          }
        ]
      },
      "createdAt": "Mon Oct 26 2026 12:07:49 GMT+0100 (Central European Standard Time)",
      "updatedAt": "2026-10-26T11:10:18.762Z"
    },
